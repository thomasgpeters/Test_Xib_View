/* *   Menus.incl - the app's menu bar: File, Edit and the app's own commands */void local fn BuildMenu// build File menumenu _mFile,,, @"File"menu _mFile, _iClose,, @"Close", @"w"MenuItemSetAction( _mFile, _iClose, @"performClose:" )// build Hello menu// menu _mHello,,, @"Hello"// menu _mHello, _iSayHello,, @"Say Hello", @"l"end fn