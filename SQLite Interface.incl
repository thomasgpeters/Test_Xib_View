// Create global URL to contacts.db on Desktop for duration of demo programlocal fn CreateGlobalURL as CFURLRefCFURLRef desktopURLCFURLRef aDatabaseURLdesktopURL = fn FileManagerURLForDirectory( NSDesktopDirectory, NSUserDomainMask )aDatabaseURL = fn URLByAppendingPathComponent( desktopURL, @"contacts.sqlite" )end fn = aDatabaseURL// YES when the database file has the app's tables. A missing file, or the empty file// sqlite3_open leaves behind when it is called on a missing path, returns NO.local fn DatabaseHasTables( databaseURL as CFURLRef ) as BOOLsqlite3Ptr      dbsqlite3_stmtPtr statementBOOL            hasTables = NOif ( fn FileManagerFileExistsAtURL( databaseURL ) == NO ) then exit fn = NOif ( fn SQL3Open( fn URLPath( databaseURL ), @db ) == _SQLITEOK )if ( fn SQL3PrepareV2( db, @"SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = 'person'", @statement ) == _SQLITEOK )if ( fn SQL3Step( statement ) == _SQLITEROW ) then hasTables = ( fn SQL3ColumnInt( statement, 0 ) > 0 )fn SQL3Finalize( statement )end iffn SQL3Close( db )end ifend fn = hasTables// Open SQLite3 Database connectionlocal fn OpenSQLite3Database( databaseURL as CFURLRef ) as BOOLBOOL isOpen// if ( fn FileManagerFileExistsAtURL( gDatabaseURL ) == _false )// ControlSetStringValue( _status1Label, @"Database missing. Relaunch app to create new database." )// exit fn// elseif ( fn SQL3Open( fn URLPath( databaseURL ), @gDatabasePtr ) == _SQLITEOK )isOpen = YES// upgrade databases created before person.balance existed (fails harmlessly once the column is there)fn SQL3Exec( gDatabasePtr, @"ALTER TABLE person ADD COLUMN balance REAL DEFAULT 0;" )elseisOpen = NOend if// end ifend fn = isOpen// Close SQLite3 Database connectionlocal fn CloseSQLite3Database as BOOLBOOL isOpenif ( gDBIsConnected )fn SQL3Close( gDatabasePtr )isOpen = NOelseisOpen = YESend ifend fn = isOpenlocal fn OpenSQLite as longdim as long returnValuedim as CFURLRef myHomeDirURLfn NSLog( @"SQLite version = %ld", fn sqlite3_libversion_number() )myHomeDirURL = fn URLWithString(  @"/Users/thomaspeters/sqlite/" )// desktopURL = fn FileManagerURLForDirectory( NSDesktopDirectory, NSUserDomainMask )gDatabaseURL = fn URLByAppendingPathComponent( myHomeDirURL, @"MySQLite3.DB" )if ( fn FileManagerFileExistsAtURL( gDatabaseURL ) == YES )returnValue = fn SQL3Open( fn URLPath( gDatabaseURL ), @gDatabasePtr )if ( returnValue == _SQLITEOK )fn NSLog( @"SQLite Database opened at: %@", gDatabaseURL )end ifelsefn NSLog( @"SQLite Database not found" )end ifend fn = returnValuelocal fn CloseSQLite as longdim code as longif ( gDatabasePtr ) then code = fn SQL3Close( gDatabasePtr )end fn = codelocal modedim as long                      curColumn, columnType, rowCountdim as CFStringRef               columnNamedim as CFMutableArrayRef         resultsDataArrayRefdim as CFMutableDictionaryRef    queryResults, resultsColumnData, resultsMetadata/* * queryResults   <-- the return type *      | *      |___ resultsColumnNamesArrayRef        <-- an array of Column Names *      | *      |___ resultsMetadata                   <-- a Dictionary of Col Data Types     e.g. the Type of Data for each Column in a Row in the results *      | *      |___ resultsDataArrayRef               <-- an array of Row Data               e.g. each element in the array every row in the result set *                   | *                   | *                   |___ resultsColumnData    <-- a Dictionary of Col Data Types     e.g. the Data for each Column in a Row in the results */local fn ExecutePreparedStatement( statement as sqlite3_stmtPtr, queryDictionaryRef as CFMutableDictionaryRef ) as CFMutableDictionaryRefqueryResults = fn CFDictionaryCreateMutable( _kCFAllocatorDefault, 0, @kCFCopyStringDictionaryKeyCallBacks, @kCFTypeDictionaryValueCallBacks )resultsMetadata = fn CFDictionaryCreateMutable( _kCFAllocatorDefault, 0, @kCFCopyStringDictionaryKeyCallBacks, @kCFTypeDictionaryValueCallBacks )resultsDataArrayRef = fn CFArrayCreateMutable( _kCFAllocatorDefault, 0, @kCFTypeArrayCallBacks )rowCount = 0 //initialize rowCountwhile ( fn SQL3Step( statement ) == _SQLITEROW )resultsColumnData = fn CFDictionaryCreateMutable( _kCFAllocatorDefault, 0, @kCFCopyStringDictionaryKeyCallBacks, @kCFTypeDictionaryValueCallBacks )rowCount++ //increment rowCountfor curColumn = 0 to fn SQL3DataCount( statement ) - 1//get the SQLite column typecolumnType = fn SQL3ColumnType( statement, curColumn )columnName = fn SQL3ColumnName( statement, curColumn )if rowCount = 1fn CFDictionaryAddValue( resultsMetadata, columnName, @( columnType ))end if// fn NSLog( @"%@ type is: %ld", columnName, columnType )select case columnTypecase _SQLITEINTEGER// fn NSLog( @"%@ = %ld", columnName, fn SQL3ColumnInt( statement, curColumn ))fn CFDictionaryAddValue( resultsColumnData, columnName, @(fn SQL3ColumnInt( statement, curColumn )))case _SQLITEFLOAT// fn NSLog( @"%@ = %g", columnName, fn SQL3ColumnDouble( statement, curColumn ))fn CFDictionaryAddValue( resultsColumnData, columnName, @(fn SQL3ColumnDouble( statement, curColumn )))case _SQLITE3TEXT// fn NSLog( @"%@ = %@", columnName , fn SQL3ColumnText( statement, curColumn ))fn CFDictionaryAddValue( resultsColumnData, columnName, fn SQL3ColumnText( statement, curColumn ))case _SQLITEBLOB// fn NSLog( @"%@ = %@", columnName , @"is a BLOB" )case _SQLITENULL// fn NSLog( @"%@ = %@", columnName , @"is NULL" )fn CFDictionaryAddValue( resultsColumnData, columnName, NULL )case elsefn NSLog( @"column type not handled" )end selectnext curColumnfn CFArrayAppendValue( resultsDataArrayRef, resultsColumnData )wendfn CFDictionaryAddValue( queryResults, @"metadata", resultsMetadata )fn CFDictionaryAddValue( queryResults, @"data", resultsDataArrayRef )fn SQL3Finalize( statement )end fn = queryResults/* *  SQLite bind * *  Values come from filter entries ( AddFilterToQuery ) and column entries *  ( AddColumnToInsert / AddColumnToUpdate ): dictionaries with "value" and "type". *  A value may be a CFStringRef or a CFNumberRef; NULL or _nullType binds SQL NULL. *  Text is bound with length -1 so SQLite measures the UTF-8 bytes itself. */local fn SQLBindValue( statement as sqlite3_stmtPtr, index as long, value as CFTypeRef, valueType as long ) as longlong   rcSInt64 intValuedouble realValueif ( value == NULL || valueType == _nullType ) then exit fn = fn sqlite3_bind_null( statement, index )select ( valueType )case _integerTypeif ( fn ObjectIsKindOfClass( (ObjectRef)value, fn NumberClass ) ) then intValue = fn NumberLongLongValue( (CFNumberRef)value ) else intValue = fn StringLongLongValue( fn StringWithFormat( @"%@", value ) )rc = fn sqlite3_bind_int64( statement, index, intValue )case _realTypeif ( fn ObjectIsKindOfClass( (ObjectRef)value, fn NumberClass ) ) then realValue = fn NumberDoubleValue( (CFNumberRef)value ) else realValue = fn StringDoubleValue( fn StringWithFormat( @"%@", value ) )rc = fn SQL3BindDouble( statement, index, realValue )case else   // _textType; _blobType is bound as textrc = fn SQL3BindText( statement, index, fn StringWithFormat( @"%@", value ), -1, _TRANSIENT )end selectend fn = rc// Bind an array of entries to the ? placeholders from firstIndex on. Filters using// _isNull / _isNotNull have no placeholder and are skipped. Returns the next free index.local fn SQLBindValues( statement as sqlite3_stmtPtr, valuesArrayRef as CFArrayRef, firstIndex as long ) as longCFDictionaryRef entryCFNumberRef     operatorReflong            index = firstIndex, opif ( valuesArrayRef == NULL ) then exit fn = firstIndexfor entry in valuesArrayRefop = _isEqualoperatorRef = fn DictionaryObjectForKey( entry, @"operator" )if ( operatorRef != NULL ) then op = fn NumberIntegerValue( operatorRef )if ( op != _isNull && op != _isNotNull )fn SQLBindValue( statement, index, fn DictionaryObjectForKey( entry, @"value" ), fn NumberIntegerValue( fn DictionaryObjectForKey( entry, @"type" ) ) )index++end ifnextend fn = index// SELECT: prepare the SQL from GenerateSelectSQL and bind its filter valueslocal fn BuildPreparedStatement_Select( myDbHandle as sqlite3Ptr, mySQLString as CFStringRef, selectfilterArrayRef as CFMutableArrayRef ) as sqlite3_stmtPtrsqlite3_stmtPtr statement = NULLif ( fn SQL3PrepareV2( myDbHandle, mySQLString, @statement ) == _SQLITEOK )fn SQLBindValues( statement, selectfilterArrayRef, 1 )elseNSLog( @"Prepare failed: %@\nSQL: %@", fn SQL3ErrorMsg( myDbHandle ), mySQLString )end ifend fn = statement// INSERT / UPDATE / DELETE: prepare the SQL and bind "columnvalues" (VALUES / SET)// then "filter" (WHERE), in placeholder order. NULL when the SQL is missing or invalid.local fn BuildPreparedStatement( myDbHandle as sqlite3Ptr, mySQLString as CFStringRef, writeDictionaryRef as CFMutableDictionaryRef ) as sqlite3_stmtPtrsqlite3_stmtPtr statement = NULLlong            nextIndexif ( mySQLString == NULL ) then exit fn = NULLif ( fn SQL3PrepareV2( myDbHandle, mySQLString, @statement ) != _SQLITEOK )NSLog( @"Prepare failed: %@\nSQL: %@", fn SQL3ErrorMsg( myDbHandle ), mySQLString )exit fn = NULLend ifnextIndex = fn SQLBindValues( statement, fn DictionaryObjectForKey( writeDictionaryRef, @"columnvalues" ), 1 )fn SQLBindValues( statement, fn DictionaryObjectForKey( writeDictionaryRef, @"filter" ), nextIndex )end fn = statement// Run a prepared INSERT / UPDATE / DELETE and finalize it. Returns the rows changed, or -1.local fn ExecuteWriteStatement( myDbHandle as sqlite3Ptr, statement as sqlite3_stmtPtr ) as longlong rc, changed = -1if ( statement == NULL ) then exit fn = -1rc = fn SQL3Step( statement )if ( rc == _SQLITEDONE ) then changed = fn sqlite3_changes( myDbHandle ) else NSLog( @"Write failed (%ld): %@", rc, fn SQL3ErrorMsg( myDbHandle ) )fn SQL3Finalize( statement )end fn = changed// INSERT described by an insert dictionary. Returns the new row's id, or -1.local fn ExecuteInsert( myDbHandle as sqlite3Ptr, insertDictionaryRef as CFMutableDictionaryRef ) as SInt64sqlite3_stmtPtr statement = fn BuildPreparedStatement( myDbHandle, fn GenerateInsertIntoSQL( insertDictionaryRef ), insertDictionaryRef )if ( fn ExecuteWriteStatement( myDbHandle, statement ) < 1 ) then exit fn = -1end fn = fn sqlite3_last_insert_rowid( myDbHandle )// UPDATE described by an update dictionary. Returns the rows changed, or -1.local fn ExecuteUpdate( myDbHandle as sqlite3Ptr, updateDictionaryRef as CFMutableDictionaryRef ) as longend fn = fn ExecuteWriteStatement( myDbHandle, fn BuildPreparedStatement( myDbHandle, fn GenerateUpdateSQL( updateDictionaryRef ), updateDictionaryRef ) )// DELETE described by a delete dictionary. Returns the rows deleted, or -1.local fn ExecuteDelete( myDbHandle as sqlite3Ptr, deleteDictionaryRef as CFMutableDictionaryRef ) as longend fn = fn ExecuteWriteStatement( myDbHandle, fn BuildPreparedStatement( myDbHandle, fn GenerateDeleteFromSQL( deleteDictionaryRef ), deleteDictionaryRef ) )