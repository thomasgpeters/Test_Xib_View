// DataObject.glbl and DataObject_Super.incl are included ahead of this file in data.fbprojinclude "NSLog.incl"/* * WHERE clause from a "filter" array built with fn AddFilterToQuery. *   useAlias    YES -> alias.column (SELECT), NO -> column (UPDATE / DELETE) *   connector   @" WHERE ", or @" AND " when joins already started the WHERE * Filters after the first are joined by their logic (_and / _or), AND when none was given. * Returns the number of filters written (0 writes nothing). */local fn AppendWhereSQL( sqlString as CFMutableStringRef, filterArrayRef as CFArrayRef, useAlias as BOOL, connector as CFStringRef ) as longCFDictionaryRef filterDictionaryRefCFNumberRef     numberReflong            filterCount, i, aOperator, aLogicif ( filterArrayRef == NULL ) then exit fn = 0filterCount = fn ArrayCount( filterArrayRef )if ( filterCount == 0 ) then exit fn = 0MutableStringAppendString( sqlString, connector )for i = 0 to filterCount - 1filterDictionaryRef = fn ArrayObjectAtIndex( filterArrayRef, i )if ( i > 0 )aLogic = _andnumberRef = fn DictionaryObjectForKey( filterDictionaryRef, @"logic" )if ( numberRef != NULL ) then aLogic = fn NumberIntegerValue( numberRef )if ( aLogic == _or ) then MutableStringAppendString( sqlString, @" OR " ) else MutableStringAppendString( sqlString, @" AND " )end ifif ( useAlias ) then MutableStringAppendString( sqlString, fn StringWithFormat( @"%@.", fn DictionaryObjectForKey( filterDictionaryRef, @"tablealias" ) ) )MutableStringAppendString( sqlString, fn DictionaryObjectForKey( filterDictionaryRef, @"columnname" ) )aOperator = fn NumberIntegerValue( fn DictionaryObjectForKey( filterDictionaryRef, @"operator" ) )select ( aOperator )case _isNotEqual            : MutableStringAppendString( sqlString, @" != ?" )case _isLessThan            : MutableStringAppendString( sqlString, @" < ?" )case _isGreaterThan         : MutableStringAppendString( sqlString, @" > ?" )case _isLessThanOrEqual     : MutableStringAppendString( sqlString, @" <= ?" )case _isGreaterThanOrEqual  : MutableStringAppendString( sqlString, @" >= ?" )case _isIn                  : MutableStringAppendString( sqlString, @" IN ( ? )" )case _isNotIn               : MutableStringAppendString( sqlString, @" NOT IN ( ? )" )case _isNull                : MutableStringAppendString( sqlString, @" IS NULL" )case _isNotNull             : MutableStringAppendString( sqlString, @" IS NOT NULL" )case _isLike                : MutableStringAppendString( sqlString, @" LIKE ?" )case _isNotLike             : MutableStringAppendString( sqlString, @" NOT LIKE ?" )case else                   : MutableStringAppendString( sqlString, @" = ?" )end selectnextend fn = filterCountlocal modedim as CFMutableArrayRef         selectcolsArrayRef, selecttablesArrayRef, selectassociationsArrayRef, selectfilterArrayRefdim as CFMutableDictionaryRef    columnDictionaryRef, tableDictionaryRef, associationsDictionaryRef, filterDictionaryRefdim as CFMutableStringRef        mySQLStringdim as CFIndex                   sqlColumnCount, sqlTableCount, sqlAssociationCount, sqlFilterCount, idim as CFNumberRef               myOperator, columnLogicdim as long                      aOperator, aLogiclocal fn GenerateSelectSQL( queryDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefmySQLString = fn CFStringCreateMutable( _kCFAllocatorDefault, _noNaxCharacters )fn CFStringAppend(mySQLString, @"SELECT ")if ( fn CFDictionaryContainsKey( queryDictionaryRef, @"selectcols" ) )selectcolsArrayRef = (CFMutableArrayRef)fn CFDictionaryGetValue( queryDictionaryRef, @"selectcols" )if ( selectcolsArrayRef )sqlColumnCount = fn CFArrayGetCount( selectcolsArrayRef )for i = 0 to sqlColumnCount - 1columnDictionaryRef = (CFMutableDictionaryRef) fn CFArrayGetValueAtIndex( selectcolsArrayRef, i )fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( columnDictionaryRef, @"columnname" ))fn CFStringAppend( mySQLString, @" AS " )fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( columnDictionaryRef, @"aliasname" ))if ( i < sqlColumnCount - 1 ) then fn CFStringAppend( mySQLString, @", ")next iend ifend iffn CFStringAppend( mySQLString, @" FROM " )if ( fn CFDictionaryContainsKey( queryDictionaryRef, @"selecttables" ))selecttablesArrayRef = (CFMutableArrayRef)fn CFDictionaryGetValue( queryDictionaryRef, @"selecttables" )if ( selecttablesArrayRef )sqlTableCount = fn CFArrayGetCount( selecttablesArrayRef )for i = 0 to sqlTableCount - 1tableDictionaryRef = (CFMutableDictionaryRef) fn CFArrayGetValueAtIndex( selecttablesArrayRef, i )fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( tableDictionaryRef, @"tablename"))fn CFStringAppend( mySQLString, @" AS ")fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( tableDictionaryRef, @"aliasname"))if ( i < sqlTableCount - 1 ) then fn CFStringAppend( mySQLString, @", ")next iend ifend ifif ( fn CFDictionaryContainsKey( queryDictionaryRef, @"associations" ) )selectassociationsArrayRef = (CFMutableArrayRef)fn CFDictionaryGetValue( queryDictionaryRef, @"associations" )if ( selectassociationsArrayRef )sqlAssociationCount = fn CFArrayGetCount( selectassociationsArrayRef )if ( sqlAssociationCount > 0 )fn CFStringAppend(mySQLString, @" WHERE ")for i = 0 to sqlAssociationCount - 1if ( i > 0 ) then fn CFStringAppend( mySQLString, @" AND " )associationsDictionaryRef = (CFMutableDictionaryRef) fn CFArrayGetValueAtIndex( selectassociationsArrayRef, i )fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( associationsDictionaryRef, @"lefttablealias" ))fn CFStringAppend( mySQLString, @"." )fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( associationsDictionaryRef, @"leftcolumnname" ))/* * * Operator           Meaning * a = b              a is equal to b * a != b             a is not equal to b * a < b              a is less than b * a > b              a is greater than b * a <= b             a is less than or equal to b * a >= b             a is greater than or equal to b * a IN (b, c)        a is equal to either b or c * a NOT IN (b, c)    a is equal to neither b nor c * a LIKE             a is LIKE 'b%' * a NOT LIKE         a is NOT LIKE 'b%' * *  only equal ( = ) should be used with associations *  associations are the JOINS in the SQL SELECT STATEMENT * */myOperator = (CFNumberRef)fn CFDictionaryGetValue( associationsDictionaryRef, @"operator" )fn CFNumberGetValue( myOperator, fn CFNumberGetType( myOperator ), @aOperator )select case aOperatorcase _isEqual : fn CFStringAppend( mySQLString, @" = " )case _isNotEqual : fn CFStringAppend( mySQLString, @" != " )case _isLessThan : fn CFStringAppend( mySQLString, @" < " )case _isGreaterThan : fn CFStringAppend( mySQLString, @" > " )case _isLessThanOrEqual : fn CFStringAppend( mySQLString, @" <= " )case _isGreaterThanOrEqual : fn CFStringAppend( mySQLString, @" >= " )case _isIn : fn CFStringAppend( mySQLString, @" IN " )case _isNotIn : fn CFStringAppend( mySQLString, @" NOT IN " )end selectfn CFRelease( myOperator )fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( associationsDictionaryRef, @"righttablealias" ))fn CFStringAppend( mySQLString, @".")fn CFStringAppend( mySQLString, fn CFDictionaryGetValue( associationsDictionaryRef, @"rightcolumnname" ))next iend ifend ifend if// filters - after the joins (AND) or starting the WHEREif ( fn CFDictionaryContainsKey( queryDictionaryRef, @"filter" ) )if ( sqlAssociationCount > 0 )fn AppendWhereSQL( mySQLString, fn CFDictionaryGetValue( queryDictionaryRef, @"filter" ), YES, @" AND " )elsefn AppendWhereSQL( mySQLString, fn CFDictionaryGetValue( queryDictionaryRef, @"filter" ), YES, @" WHERE " )end ifend ifend fn = mySQLString/* * INSERT INTO table ( col1, col2 ) VALUES ( ?, ? ) * from a dictionary built with InitInsertIntoDictionary / AddTableToInsert / AddColumnToInsert. * NULL when the table or columns are missing. */local fn GenerateInsertIntoSQL( insertDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefCFMutableStringRef sqlString, valuesStringCFArrayRef         columnValuesArrayRefCFStringRef        tableNamelong               columnCount, itableName            = fn DictionaryObjectForKey( insertDictionaryRef, @"insertintotable" )columnValuesArrayRef = fn DictionaryObjectForKey( insertDictionaryRef, @"columnvalues" )if ( tableName == NULL || columnValuesArrayRef == NULL ) then exit fn = NULLcolumnCount = fn ArrayCount( columnValuesArrayRef )if ( fn StringLength( tableName ) == 0 || columnCount == 0 ) then exit fn = NULLsqlString    = fn MutableStringNewvaluesString = fn MutableStringNewMutableStringAppendString( sqlString, fn StringWithFormat( @"INSERT INTO %@ ( ", tableName ) )for i = 0 to columnCount - 1if ( i > 0 )MutableStringAppendString( sqlString, @", " )MutableStringAppendString( valuesString, @", " )end ifMutableStringAppendString( sqlString, fn DictionaryObjectForKey( fn ArrayObjectAtIndex( columnValuesArrayRef, i ), @"columnname" ) )MutableStringAppendString( valuesString, @"?" )nextMutableStringAppendString( sqlString, fn StringWithFormat( @" ) VALUES ( %@ )", valuesString ) )end fn = sqlString/* * UPDATE table SET col1 = ?, col2 = ? WHERE ... * from a dictionary built with InitUpdateDictionary / AddTableToUpdate / AddColumnToUpdate * and AddFilterToQuery (table alias ignored). NULL without a filter, so an UPDATE can * never change every row by accident. */local fn GenerateUpdateSQL( updateDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefCFMutableStringRef sqlStringCFArrayRef         columnValuesArrayRefCFStringRef        tableNamelong               columnCount, itableName            = fn DictionaryObjectForKey( updateDictionaryRef, @"updatetable" )columnValuesArrayRef = fn DictionaryObjectForKey( updateDictionaryRef, @"columnvalues" )if ( tableName == NULL || columnValuesArrayRef == NULL ) then exit fn = NULLcolumnCount = fn ArrayCount( columnValuesArrayRef )if ( fn StringLength( tableName ) == 0 || columnCount == 0 ) then exit fn = NULLsqlString = fn MutableStringNewMutableStringAppendString( sqlString, fn StringWithFormat( @"UPDATE %@ SET ", tableName ) )for i = 0 to columnCount - 1if ( i > 0 ) then MutableStringAppendString( sqlString, @", " )MutableStringAppendString( sqlString, fn StringWithFormat( @"%@ = ?", fn DictionaryObjectForKey( fn ArrayObjectAtIndex( columnValuesArrayRef, i ), @"columnname" ) ) )nextif ( fn AppendWhereSQL( sqlString, fn DictionaryObjectForKey( updateDictionaryRef, @"filter" ), NO, @" WHERE " ) == 0 )NSLog( @"GenerateUpdateSQL: no filter - refusing to update every row of %@", tableName )exit fn = NULLend ifend fn = sqlString/* * DELETE FROM table WHERE ... * from a dictionary built with InitDeleteFromDictionary / AddTableToDelete and * AddFilterToQuery (table alias ignored). NULL without a filter, so a DELETE can * never empty a table by accident. */local fn GenerateDeleteFromSQL( deleteDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefCFMutableStringRef sqlStringCFStringRef        tableName = fn DictionaryObjectForKey( deleteDictionaryRef, @"deletefromtable" )if ( tableName == NULL ) then exit fn = NULLif ( fn StringLength( tableName ) == 0 ) then exit fn = NULLsqlString = fn MutableStringNewMutableStringAppendString( sqlString, fn StringWithFormat( @"DELETE FROM %@", tableName ) )if ( fn AppendWhereSQL( sqlString, fn DictionaryObjectForKey( deleteDictionaryRef, @"filter" ), NO, @" WHERE " ) == 0 )NSLog( @"GenerateDeleteFromSQL: no filter - refusing to delete every row of %@", tableName )exit fn = NULLend ifend fn = sqlString